# Config CORS
CORS_ORIGIN=*

# Config PORT
PORT=8080

# Graceful shutdown timeout (required, no default)
SHUTDOWN_TIMEOUT_MS=20000

# Rate limiting on /api/auth & /api/admin (required, no default) — also covers /api/auth/login
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_CLEANUP_INTERVAL_MS=60000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:password@localhost:5433/labor_project
DOCKER_DATABASE_URL=postgresql://postgres:password@host.docker.internal:5433/labor_project

# DigitalOcean Spaces — for admin profile image uploads
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_REGION=sgp1
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=

# Uploads — public-read bucket for admin profile images
SPACES_ADMIN_BUCKET=labor-project-uploads

# Security audit log retention, in days (optional, default 180)
SECURITY_AUDIT_LOG_RETENTION_DAYS=180

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_REFRESH
JWT_LOGIN_CHALLENGE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_LOGIN_CHALLENGE
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_LOGIN_CHALLENGE_EXPIRES_IN=5m
# Refresh token storage hash
REFRESH_TOKEN_HASH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32_REFRESH_HASH

# Redis / BullMQ
REDIS_URL=redis://localhost:6380
REDIS_HOST_PORT=6380
REDIS_WORKER_QUEUE_KEY=labor:worker:queue
REDIS_WORKER_STATUS_KEY_PREFIX=labor:worker:status:
REDIS_WORKER_PRESENCE_KEY_PREFIX=labor:worker:presence:
WORKER_PRESENCE_STALE_SECONDS=90
WORKER_SOCKET_DISCONNECT_GRACE_MS=15000
REDIS_WORKER_BREAK_COUNT_KEY_PREFIX=labor:worker:break-count:
BULLMQ_ASSIGNMENT_TIMEOUT_QUEUE=labor-assignment-timeouts
BULLMQ_WORKER_BREAK_RETURN_QUEUE=labor-worker-break-returns
BULLMQ_LINE_MESSAGE_QUEUE=labor-line-messages

# LINE OA
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sentry Logging / Error Tracking
SENTRY_DSN=
LOG_LEVEL=info

# Grafana Loki
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

